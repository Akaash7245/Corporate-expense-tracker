{
  "name": "corporate-expense-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "src/client",
    "src/server"
  ],
  "scripts": {
    "install:all": "npm install && cd src/ml-service && pip install -r requirements.txt",
    "dev:server": "npm run dev --workspace=src/server",
    "dev:client": "npm run dev --workspace=src/client",
    "dev:ml": "cd src/ml-service && uvicorn app.main:app --reload --port 8000",
    "seed": "node data/seed.js",
    "start": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:ml\"",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
