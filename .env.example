# ==============================================================================
# Unified Environment Configuration Example
# Copy this file to src/server/.env and adjust values as needed
# ==============================================================================

# Backend Server Port and Node Environment
PORT=5000
NODE_ENV=development

# JWT Secrets for User Authentication
JWT_SECRET=expense-tracker-super-secret-key-2024
JWT_EXPIRES_IN=24h

# CORS Configuration (points to frontend URL)
CORS_ORIGIN=http://localhost:5173

# Database configuration (SQLite default path under data/)
DB_DIALECT=sqlite
DB_STORAGE=../../data/database.sqlite

# File Uploads Directory path relative to src/server/
UPLOAD_DIR=../../uploads

# Machine Learning Service URL
ML_SERVICE_URL=http://localhost:8000
